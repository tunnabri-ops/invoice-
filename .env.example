# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Your Resend API key (starts with re_...)
# Set this in your Vercel Project Environment Variables (NEVER expose to frontend)
RESEND_API_KEY="re_your_api_key_here"

# FROM_EMAIL: Fallback default sender address if user custom sender is not set
FROM_EMAIL="invoices@yourdomain.com"

# ALLOWED_DOMAINS: Comma-separated list of administrator-approved, Resend-verified domains
# Users can only choose usernames on these specific domains (e.g. "billing.mycompany.com,acme.com")
ALLOWED_DOMAINS="yourdomain.com,billing.yourdomain.com"
