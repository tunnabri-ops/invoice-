# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Your Resend API key (starts with re_...)
# Set this in your Vercel Project Environment Variables (NEVER expose to frontend)
RESEND_API_KEY="re_your_api_key_here"

# FROM_EMAIL: Fallback default sender address
FROM_EMAIL="billing@mybusinessgmail.com"

# ALLOWED_DOMAINS: Comma-separated list of administrator-approved, Resend-verified domains
ALLOWED_DOMAINS="mybusinessgmail.com,jiohotstar.dev,mybusinessgmail.info,coxoxa.com,nagadbd.info,10min-mail.com,akleatherbd.digital,telegra.dev,lalaji.xyz,chorki.pro"
